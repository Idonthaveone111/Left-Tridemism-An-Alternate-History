@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1926;
Q.month = 11;
Q.week = 1;
Q.week_checked = 0;
// how many actions have been taken this month?
Q.week_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics

Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.1;
Q.dissent_percent = 10;

// factions
Q.factions = ['ccp_dual_members', 'left', 'center', 'right'];
// should this be normalized to 100%?
Q.ccp_dual_members_strength = 15;
Q.ccp_dual_members_dissent = 10;
Q.left_strength = 35;
Q.left_dissent = 5;
Q.center_strength = 25;
Q.center_dissent = 15;
Q.right_strength = 10;
Q.right_dissent = 25;

// outside influence (CCP, democracy)
Q.ccp_influence = 0;
Q.constitutional_influence = 0;

// secret events...
Q.ccp_split = 0;
Q.left_split = 0;
Q.center_abandons = 0;
Q.right_split = 0;

// united front joever
Q.united_front_broken = 0;
Q.united_front_integrity = 75;
Q.united_front_dissent = 2;
Q.wuhan_nanjing_split = 0;

// support for the revolution
Q.rural_revolutionary_ccp = 35;
Q.rural_revolutionary_kmt = 45;
Q.urban_revolutionary_ccp = 55;
Q.urban_revolutionary_kmt = 45;

Q.average_revolution_united = 45; // averaged values of the united front kmt + ccp
Q.average_revolution_split = 45; // averaged values of just the kmt
Q.average_rural_revolution_united = 40; // averaged rural values with ccp
Q.average_rural_revolution_split = 45; // averaged without ccp
Q.average_urban_revolution_united = 50;
Q.average_urban_revolution_split = 45;

// revolutionary unrest
Q.rural_unrest = 0;
Q.urban_unrest = 0;
Q.industrialist_unrest = 0;

// organizations
// inter-party relations
Q.ccp_relation = 65;
Q.nanjing_kmt_relation = 30;
