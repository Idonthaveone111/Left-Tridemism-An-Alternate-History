Q.landlords_ccp = 0;
Q.landlords_minor_republican_parties = 10;
Q.landlords_other = 50;

Q.workers_kmt = 40;
Q.workers_nanjing_kmt = 15;
Q.workers_ccp = 25; 
Q.workers_minor_republican_parties = 5;
Q.workers_other = 15;

Q.middle_class_kmt = 25;
Q.middle_class_nanjing_kmt = 35;
Q.middle_class_ccp = 10;
Q.middle_class_minor_republican_parties = 10;
