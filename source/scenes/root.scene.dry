@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1926;
Q.month = 11;
Q.week = 1;
Q.week_checked = 0;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics

Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 5;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.1;
Q.dissent_percent = 10;

// factions
Q.factions = ['ccp_dual_members', 'left', 'center', 'right'];
// should this be normalized to 100%?
Q.ccp_dual_members_strength = 15;
Q.ccp_dual_members_dissent = 10;
Q.left_strength = 35;
Q.left_dissent = 5;
Q.center_strength = 25;
Q.center_dissent = 15;
Q.right_strength = 10;
Q.right_dissent = 25;

// outside influence (CCP, democracy)
Q.ccp_influence = 0;
Q.constitutional_influence = 0;

// secret events...
Q.ccp_split = 0;
Q.left_split = 0;
Q.center_abandons = 0;
Q.right_abandons = 0;

// support for the revolution
Q.rural_revolutionary_ccp = 0;
Q.rural_revolutionary_kmt = 0;
Q.urban_revolutionary_ccp = 0;
Q.urban_revolutionary_kmt = 0;

// revolutionary unrest
Q.rural_unrest = 0;
Q.urban_unrest = 0;
Q.industrialist_unrest = 0;

// organizations
// inter-party relations
Q.ccp_relation = 65;
Q.nanjing_kmt_relation = 30;
Q.yunnan_relation = 60;
Q.guangdong_relation = 50;
Q.guangxi_relation = 50;
Q.sichuan_relation = 55;
Q.shanxi_yan_relation = 50;
Q.shaanxi_feng_relation = 55;
Q.minor_republican_parties = 35;
Q.other = 35; // apolitical and minor parties

Q.ccp_leader = "Chen Duxiu";
Q.nanjing_kmt_leader = "Jiang Jieshi";
Q.yunnan_leader = "Yunnan Warlords";
Q.guangdong_leader = "Li Jishen";
Q.guangxi_leader = "Li Zongren";
Q.sichuan_leader = "Sichuan Warlords";
Q.shanxi_yan_leader = "Yan Xishan";
Q.shaanxi_feng_leader = "Feng Yuxiang";
Q.minor_republican_parties_leader = "Minor Republican Parties";
Q.other_leader = "Other";

// foreign powers
Q.west_relation = 5;
Q.japan_relation = 4;
Q.soviet_relation = 7;

// state of the government
// ill figure it out later
Q.united_front_integrity = 0;
Q.united_front_dissent = 0;

// national reforms
Q.banking_reform = 0;
Q.currency_reform = 0;
Q.business_reform = 0;
Q.industrial_reform = 0;
Q.nationalizations = 0;
Q.nationalizations_cost = 4;

Q.socialist_reform = 0;
Q.unions_reform = 0;

Q.government_control_rural = 0;
Q.land_reform = 0;
Q.land_collectivization = 0; // save us mao
Q.tax_reform = 0;
Q.customs_and_tariff_reform = 0;

Q.political_reform = 0;
Q.military_reform = 0;
Q.government_structure_reform = 0;
Q.civil_service_reform = 0;
Q.constitution_reform = 0;

// Tax rates relative to November 1926 baseline
Q.rural_tax_upper = 0;
Q.rural_tax_lower = 0;
Q.urban_tax_upper = 0;
Q.urban_tax_lower = 0;
Q.tariffs = 0; // I think tariffs would've been administered by the maritime customs service and weren't under the control of the government? not that the KMT was the recognized gov of China yet.

// demographics of social groups
Q.peasants = 80; // estimated based on "Mao Zedong and China's 'poor peasants' 1927-1957"
Q.landlords = 9; // ibid
Q.workers = 3; // based on Canteens and the Politics of Working-class Diets in Industrial China, 1920–37
Q.middle_class = 1;
Q.intellectuals = 2
Q.bourgeois = 1;
Q.soldiers = 4;

//Classes and Parties Lists
Q.classes = ['peasants', 'landlords', 'workers', 'middle_class', 'intellectuals', 'bourgeois', 'soldiers']; // intellectuals includes students
Q.parties = ['kmt', 'nanjing_kmt', 'ccp', 'minor_republican_parties', 'other'];
Q.parties_2 = ['yunnan', 'sichuan', 'guangdong', 'guangxi', 'sichuan', 'shanxi', 'shaanxi'] // idk man
// the "warlord" parties hopefully should not be relevant to popularity stats but im not sure if that's possible yet

// party popularities
// there are no elections but this could be useful for determining power levels etc
Q.peasants_kmt = 15;
Q.peasants_nanjing_kmt = 5;
Q.peasants_ccp = 25;
Q.peasants_minor_republican_parties = 0;
Q.peasants_other = 50;

Q.landlords_kmt = 5;
