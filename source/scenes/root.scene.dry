Q.guangdong_relation = 50;
Q.guangxi_relation = 50;
Q.sichuan_relation = 55;
Q.shanxi_yan_relation = 50;
Q.shaanxi_feng_relation = 55;
Q.minor_republican_parties_relation = 35;
Q.other_relation = 35; // apolitical and minor parties

Q.ccp_leader = "Chen Duxiu";
Q.nanjing_kmt_leader = "Jiang Jieshi";
Q.yunnan_leader = "Yunnan Warlords";
Q.guangdong_leader = "Li Jishen";
Q.guangxi_leader = "Li Zongren";
Q.sichuan_leader = "Sichuan Warlords";
Q.shanxi_yan_leader = "Yan Xishan";
Q.shaanxi_feng_leader = "Feng Yuxiang";
Q.minor_republican_parties_leader = "Minor Republican Parties";
Q.other_leader = "Other";

// warlord stuff
Q.guangdong_independent = 0; //Li Jishen declares independence
Q.yunnan_leader_victory = 0; //For when someone unified Yunnan aka long yun or lu han or some tang jiyao guy

// foreign powers
Q.west_relation = 5;
Q.japan_relation = 4;
Q.soviet_relation = 7;

Q.soviet_aid = 0; // soviet guns equipment and money

// unequal treaties


// state of the government
// ill figure it out later
Q.current_capital = "guangzhou";

// national reforms
Q.banking_reform = 0;
Q.currency_reform = 0;
Q.business_reform = 0;
Q.industrial_reform = 0;
Q.nationalizations = 0;
Q.nationalizations_cost = 4;

Q.socialist_reform = 0;
Q.unions_reform = 0;

Q.government_control_rural = 0;
Q.land_reform = 0;
Q.land_collectivization = 0; // save us mao
Q.tax_reform = 0;
Q.customs_and_tariff_reform = 0;

Q.political_reform = 0;
Q.military_reform = 0;
Q.government_structure_reform = 0;
Q.civil_service_reform = 0;
Q.constitution_reform = 0;

// Tax rates relative to November 1926 baseline
Q.rural_tax_upper = 0;
Q.rural_tax_lower = 0;
Q.urban_tax_upper = 0;
Q.urban_tax_lower = 0;
Q.tariffs = 0; // I think tariffs would've been administered by the maritime customs service and weren't under the control of the government? not that the KMT was the recognized gov of China yet.

// demographics of social groups
Q.peasants = 82; // estimated based on "Mao Zedong and China's 'poor peasants' 1927-1957"
Q.landlords = 5; // ibid
Q.workers = 6; // based on Canteens and the Politics of Working-class Diets in Industrial China, 1920–37
Q.middle_class = 1;
Q.intellectuals = 2
Q.bourgeois = 1;
Q.soldiers = 3;

//Classes and Parties Lists
Q.classes = ['peasants', 'landlords', 'workers', 'middle_class', 'intellectuals', 'bourgeois', 'soldiers']; // intellectuals includes students
Q.parties = ['kmt', 'nanjing_kmt', 'ccp', 'minor_republican_parties', 'other'];
Q.parties_2 = ['yunnan', 'sichuan', 'guangdong', 'guangxi', 'sichuan', 'shanxi', 'shaanxi'] // idk man
// the "warlord" parties hopefully should not be relevant to popularity stats but im not sure if that's possible yet

// party popularities
// there are no elections but this could be useful for determining power levels etc
Q.peasants_kmt = 15;
Q.peasants_nanjing_kmt = 5;
Q.peasants_ccp = 25;
Q.peasants_minor_republican_parties = 0;
Q.peasants_other = 50;

Q.landlords_kmt = 5;
Q.landlords_nanjing_kmt = 35; 
Q.landlords_ccp = 0;
Q.landlords_minor_republican_parties = 10;
Q.landlords_other = 50;

Q.workers_kmt = 40;
Q.workers_nanjing_kmt = 15;
Q.workers_ccp = 25; 
Q.workers_minor_republican_parties = 5;
Q.workers_other = 15;

Q.middle_class_kmt = 25;
Q.middle_class_nanjing_kmt = 35;
Q.middle_class_ccp = 10;
Q.middle_class_minor_republican_parties = 10;
Q.middle_class_other = 20;

Q.intellectuals_kmt = 30;
Q.intellectuals_nanjing_kmt = 15;
Q.intellectuals_ccp = 35;
Q.intellectuals_minor_republican_parties = 15;
Q.intellectuals_other = 5;

Q.bourgeois_kmt = 10;
