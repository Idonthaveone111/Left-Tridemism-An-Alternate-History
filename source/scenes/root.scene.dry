Q.bourgeois_ccp = 5;
Q.bourgeois_minor_republican_parties = 15;
Q.bourgeois_other = 15;

Q.soldiers_kmt = 45;
Q.soldiers_nanjing_kmt = 50;
Q.soldiers_ccp = 5;
Q.soldiers_minor_republican_parties = 0;
Q.soldiers_other = 0;

// miscellaneous variables
Q.radio = 0;
Q.united_front_policy = 0;

// economics
// oh god
Q.budget = 0;
Q.inflation = 0; // I think I will make this figure qualitative instead of quanitative (i.e. deflationary, stable, low, medium etc) cuz this data does *not* exist lol
Q.growth = 0;
Q.industrial_score = 0; // kinda just a generic score
Q.military_industry = 0; // could be useful
Q.rural_vitality = 0; // represents the general wellbeing of agriculture and rural villages, might effect growth and budget etc

// timers
Q.timers = ['advisor_action', 'advisor_sov_action', 'shuffle_leadership'];

// advisor stuff
Q.n_advisors = 3;
Q.n_advisors_sov = 1;
Q.advisor_action_timer = 0;
Q.advisor_sov_action_timer = 0;
Q.shuffle_leadership_timer = 0;

// starting advisors
Q.sun_fo_advisor = 1; // Sun Fo centrist political and constitutional
Q.jiang_jieshi_advisor = 1; // mr chiang himself military and political splits after the rupture obv
Q.tv_soong_advisor = 1; // T.V. Soong centrist but leans to the right finance
Q.mikhail_borodin_advisor_sov = 1; // Mikhail Borodin soviet advisor 

// communists in the united front
Q.tan_pingshan_advisor = 0; // Tan Pingshan agriculture?
Q.su_zhaozheng_advisor = 0; // Su Zhaozheng labour?
Q.chen_duxiu_advisor = 0; // Chen Duxiu generic communist politics or unions?
Q.mao_zedong_advisor = 0; // Mao Zedong peasant organisation
Q.zhu_de_advisor = 0; // Zhu De military

// leftists
Q.soong_qingling_advisor = 0; // Soong Qingling leftist political organisation
Q.wang_jingwei_advisor = 0; // Wang Jingwei special diplo options with jiang and warlords also not available until about april 1927
Q.eugene_chen_advisor = 0; // Eugene Chen foreign advisor
Q.deng_yanda_advisor = 0; // Deng Yanda military or peasants
Q.gu_mengyu_advisor = 0; // Gu Mengyu propaganda or education
Q.chen_gongbo_advisor = 0; // Chen Gongbo labour
Q.tang_shengzhi = 0; // Tang Shengzhi military
Q.he_xiangning_advisor = 0; // He Xiangning feminism

// zhang zhaoyuan if you can find anything about him

// centrists
// sun fo
// tv soong
Q.xu_qian_advisor = 0; // Xu Qian justice
Q.tan_yankai_advisor = 0; // Tan Yankai general politics
Q.zhu_peide_advisor = 0; // Zhu Peide military
Q.hh_kung_advisor = 0; // HH Kung might not be available until later on

// rightists
// these guys will mostly? leave after the split and the right becomes fairly inconsequential unless you change that
// jiang jieshi
Q.zhang_renjie_advisor = 0; // Zhang Renjie not really sure tbh maybe some economic stuff 
Q.li_jishen_advisor = 0; // Li Jishen some economic some military
