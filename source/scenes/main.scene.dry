title: Next Month
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 week';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' weeks';
}
if (Q.advisor_sov_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Soviet Advisors - an action is available';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Soviet Advisors - next action available in 1 week';
} else {
    Q.pinnedCardsDescription = 'Soviet Advisors - next action available in ' + Q.advisor_sov_action_timer + ' weeks';
}
!}
max-cards: 4

// here the main deck will be displayed

- @party
- @military
- @govt

@party
title: Party Affairs
card-image: img/placeholder.jpg
is-deck: true

@military
title: Military Affairs
card-image: img/placeholder.jpg
is-deck: true

@govt
title: Government Affairs
card-image: img/placeholder.jpg
is-deck: true
