title: Next Week
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0 && Q.advisor_sov_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1 && Q.advisor_sov_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors action available in 1 week. Soviet advisor action is available';
} else if (Q.advisor_action_timer >= 2 && Q.advisor_sov_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors action available in ' + Q.advisor_action_timer + ' weeks. Soviet advisor action is available.';
} else if (Q.advisor_action_timer <= 0 && Q.advisor_sov_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors action is available. Soviet advisor action available in 1 week';
} else if (Q.advisor_action_timer <= 0 && Q.advisor_sov_action_timer >= 2) {
    Q.pinnedCardsDescription = 'Advisors action is available. Soviet advisor action available in ' + Q.advisor_action_sov_timer + ' weeks';
} else if (Q.advisor_action_timer == 1 && Q.advisor_sov_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors action is available. Soviet advisor action available in ' + Q.advisor_action_sov_timer + ' weeks';
} else {
    Q.pinnedCardsDescription = 'Advisors action available in ' + Q.advisor_action_timer + ' weeks. Soviet advisor action is available in ' + Q.advisor_action_sov_timer + ' weeks';
}
!}
max-cards: 6

#here the main deck will be displayed

- @party
- @military
- @govt
- #advisor
- #soviet_advisor
- @shuffle_leadership_pinned

@party
title: Party Affairs
card-image: img/party_affairs.jpg
is-deck: true

- #party_affairs

@military
title: Military Affairs
card-image: img/military_affairs.jpg
is-deck: true

@govt
title: Government Affairs
card-image: img/government_affairs.jpg
is-deck: true
