@add_advisors
title: Add advisors
view-if: n_advisors < 3 or n_advisors_sov < 1
unavailable-subtitle: Maximum of 3 advisors
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: ccp_dual_members_advisor, left_advisor, center_advisor, right_advisor, soviet
frequency: 1

- @CCP: Add Communists
- @leftists: Add Leftists
- @centrists: Add Centrists
- @rightists: Add Rightists
- @soviet: Add Soviet Advisors
- @rm_main: Remove advisors instead.
- @remove_none: Stop changing advisors.

@CCP
view-if: n_advisors < 3

- #ccp_dual_members_advisor

@leftists
view-if: n_advisors < 3

- #left_advisor

@centrists
view-if: n_advisors < 3

- #center_advisor

@rightists
view-if: n_advisors < 3

- #right_advisor

@soviet
view-if: n_advisors_sov < 1

